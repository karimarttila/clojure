{:deps {org.clojure/clojure {:mvn/version "1.12.4"}
        metosin/reitit-core {:mvn/version "0.9.2"}
        metosin/reitit-malli {:mvn/version "0.9.2"}
        metosin/malli {:mvn/version "0.20.0"}
        integrant/integrant {:mvn/version "1.0.1"}
        integrant/repl {:mvn/version "0.5.0"}}

 :paths ["src/cljc" "resources"]

 :aliases {:backend
           {:extra-paths ["src/clj"]
            :extra-deps {metosin/reitit-ring {:mvn/version "0.9.2"}
                         metosin/reitit-malli {:mvn/version "0.9.2"}
                         metosin/reitit-middleware {:mvn/version "0.9.2"}
                         metosin/reitit-swagger {:mvn/version "0.9.2"}
                         metosin/reitit-swagger-ui {:mvn/version "0.9.2"}
                         aero/aero {:mvn/version "1.1.6"}
                         hiccup/hiccup {:mvn/version "2.0.0"}
                         ring/ring-jetty-adapter {:mvn/version "1.15.3"}
                         metosin/ring-swagger-ui {:mvn/version "5.20.0"}
                         metosin/ring-http-response {:mvn/version "0.9.5"}
                         metosin/muuntaja {:mvn/version "0.6.11"}
                         metosin/jsonista {:mvn/version "0.3.13"}
                         ch.qos.logback/logback-classic {:mvn/version "1.5.22"}
                         org.clojure/tools.logging {:mvn/version "1.3.0"}}}

           :frontend
           {:extra-paths ["src/cljs" "src/cljc" "src/js" "test/cljs" "portfolio"]
            :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.134"}
                         metosin/reitit-frontend {:mvn/version "0.9.2"}
                         com.cognitect/transit-cljs {:mvn/version "0.8.280"}
                         cljs-ajax/cljs-ajax {:mvn/version "0.8.4"}
                         org.clojure/core.match {:mvn/version "1.1.0"}
                         no.cjohansen/replicant {:mvn/version "2025.12.1"}
                         no.cjohansen/nexus {:mvn/version "2025.11.1"}
                         no.cjohansen/dataspex {:mvn/version "2025.10.2"}
                         no.cjohansen/lookup {:mvn/version "2025.12.1"}
                         no.cjohansen/portfolio {:mvn/version "2025.11.2"}
                         datascript/datascript {:mvn/version "1.7.8"}
                         cljs-http/cljs-http {:mvn/version "0.1.49"}
                         org.clojure/core.async {:mvn/version "1.8.741"}
                         org.slf4j/slf4j-simple {:mvn/version "2.0.17"}}}

           :dev
           {:extra-paths ["dev/clj" "target/dev" "test/clj"]
            :extra-deps {clj-http/clj-http {:mvn/version "3.13.1"}}}

           #_#_:repl
             {:extra-deps {nrepl/nrepl {:mvn/version "1.5.1"}}
              :jvm-opts [;; https://www.metosin.fi/blog/missing-stacktraces
                         "-XX:-OmitStackTraceInFastThrow"
                         ;; To allow nrepl interrupt threads on Java 20+
                         "-Djdk.attach.allowAttachSelf"
                         "-XX:+EnableDynamicAgentLoading"]}

           :test
           {:extra-paths ["test/clj"]
            :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
            ;; Do not add this since fails to start external backend REPL.
            #_#_:main-opts ["-m" "kaocha.runner"]}

           ;; NOTE: This is used for external repl!
           ;; DO NOT USE this alias when doing Calva Jack-in!!! 
           :calva-external-repl
           {:extra-deps {nrepl/nrepl {:mvn/version,"1.5.1"}
                         cider/cider-nrepl {:mvn/version,"0.58.0"}}
            ;; Do not add this since fails to start external backend REPL.            
            #_#_:main-opts ["-m"
                            "nrepl.cmdline"
                            "--middleware"
                            "[cider.nrepl/cider-middleware,shadow.cljs.devtools.server.nrepl/middleware]"]}

           :shadow-cljs
           {:extra-paths ["dev/cljs"]
            :extra-deps {thheller/shadow-cljs {:mvn/version "3.3.4"}
                         binaryage/devtools {:mvn/version "1.0.7"}
                         cider/cider-nrepl {:mvn/version "0.58.0"}}}

           :babashka
           {:extra-deps {babashka/process {:mvn/version "0.6.24"}}}

           :build
           {:deps {io.github.clojure/tools.build {:mvn/version "0.10.11"}}
            :ns-default build}

           :outdated
           {:deps {com.github.liquidz/antq {:mvn/version "RELEASE"}
                   org.slf4j/slf4j-simple {:mvn/version "2.0.17"}}
            :main-opts ["-m" "antq.core"]}}}


