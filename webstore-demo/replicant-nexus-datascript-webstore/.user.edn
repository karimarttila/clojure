{; Example .user.edn file to configure :repl-command for bb.edn
 ; Calva REPL.
 :backend-repl-command ["clojure -M:dev:backend:calva-external-repl:kari -i bb-scripts/backendinit.clj -m nrepl.cmdline --middleware \"[cider.nrepl/cider-middleware]\""]
 :frontend-repl-command ["clojure -M:shadow-cljs:frontend:kari -i bb-scripts/frontendinit.clj -m shadow.cljs.devtools.cli watch app"]
 :tailwind-watch ["npm run postcss:watch"]
 }
