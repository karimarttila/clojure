;; Babashka task runner.

{:paths ["bb-scripts"]

 :tasks {:requires ([tasks :as t])
         backend-repl {:doc "Start backend nREPL process. In Calva use deps.edn project type."
                       :task (t/run-command :backend-repl-command ".user.edn")}
         frontend-repl {:doc "Start frontend nREPL process. In Calva use shadow-cljs project type."
                        :task (t/run-command :frontend-repl-command ".user.edn")}
         outdated {:doc "Check depdendencies"
                   :task (clojure "-M:outdated")}
         lint {:doc "Lint"
               :task (shell "clj-kondo --lint src")}
         init-lint {:doc "Initialize clj-kondo cache and copy lib configs"
                    :task (shell "sh -c" "clj-kondo --copy-configs --lint $(clj -Spath -A:backend:frontend)")}}
 }
